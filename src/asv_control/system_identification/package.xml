<?xml version="1.0"?>
<package format="3">
  <name>system_identification</name>
  <version>0.0.1</version>
  <description>WAM-V system identification node with multiple tests.</description>

  <maintainer email="you@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <!-- Build system for Python packages -->
